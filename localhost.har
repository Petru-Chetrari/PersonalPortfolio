            "compression": -42,
            "text": "<!DOCTYPE html><html lang=\"en\" class> <head><meta charset=\"utf-8\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><meta name=\"viewport\" content=\"width=device-width\"><meta name=\"generator\" content=\"Astro v6.4.2\"><title>Astro</title><meta name=\"astro-view-transitions-enabled\" content=\"true\"><meta name=\"astro-view-transitions-fallback\" content=\"animate\"><script type=\"module\" src=\"/node_modules/astro/components/ClientRouter.astro?astro&type=script&index=0&lang.ts\"></script><!-- Inline script blocks parsing, applies theme before rendering to avoid flash --><script>\n\t\t\t(function() {\n\t\t\t\tvar match = document.cookie.match(new RegExp('(^| )user-prefs=([^;]+)'));\n\t\t\t\tvar theme = 'system';\n\t\t\t\tvar motion = 'system';\n\t\t\t\tif (match) {\n\t\t\t\t\ttry {\n\t\t\t\t\t\tvar prefs = JSON.parse(decodeURIComponent(match[2]));\n\t\t\t\t\t\tif (prefs.theme) theme = prefs.theme;\n\t\t\t\t\t\tif (prefs.reducedMotion) motion = prefs.reducedMotion;\n\t\t\t\t\t} catch(e) {}\n\t\t\t\t}\n\n\t\t\t\tvar doc = document.documentElement;\n\t\t\t\tif (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {\n\t\t\t\t\tdoc.classList.add('dark');\n\t\t\t\t\tdoc.classList.remove('light');\n\t\t\t\t} else {\n\t\t\t\t\tdoc.classList.add('light');\n\t\t\t\t\tdoc.classList.remove('dark');\n\t\t\t\t}\n\n\t\t\t\tif (motion === 'true' || (motion === 'system' && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {\n\t\t\t\t\tdoc.setAttribute('data-reduced-motion', 'true');\n\t\t\t\t} else {\n\t\t\t\t\tdoc.removeAttribute('data-reduced-motion');\n\t\t\t\t}\n\t\t\t})();\n\t\t</script><style data-vite-dev-id=\"D:/Projects/SIDA/PersonalPortfolio/my-design-system/node_modules/astro/components/ClientRouter.astro?astro&amp;type=style&amp;index=0&amp;lang.css\">/* Route announcer */\n\t.astro-route-announcer {\n\t\tposition: absolute;\n\t\tleft: 0;\n\t\ttop: 0;\n\t\tclip: rect(0 0 0 0);\n\t\tclip-path: inset(50%);\n\t\toverflow: hidden;\n\t\twhite-space: nowrap;\n\t\twidth: 1px;\n\t\theight: 1px;\n\t}</style>\n<style data-vite-dev-id=\"D:/Projects/SIDA/PersonalPortfolio/my-design-system/src/styles/global.css\">/*! tailwindcss v4.2.2 | MIT License | https://tailwindcss.com */\n@layer properties;\n@layer theme, base, components, utilities;\n@layer theme {\n  :root, :host {\n    --font-sans: ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\",\n      \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\";\n    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\",\n      \"Courier New\", monospace;\n    --color-red-400: oklch(70.4% 0.191 22.216);\n    --color-amber-400: oklch(82.8% 0.189 84.429);\n    --color-yellow-500: oklch(79.5% 0.184 86.047);\n    --color-emerald-400: oklch(76.5% 0.177 163.223);\n    --color-emerald-500: oklch(69.6% 0.17 162.48);\n    --color-blue-300: oklch(80.9% 0.105 251.813);\n    --color-blue-400: oklch(70.7% 0.165 254.624);\n    --color-blue-500: oklch(62.3% 0.214 259.815);\n    --color-slate-50: oklch(98.4% 0.003 247.858);\n    --color-slate-100: oklch(96.8% 0.007 247.896);\n    --color-slate-200: oklch(92.9% 0.013 255.508);\n    --color-slate-300: oklch(86.9% 0.022 252.894);\n    --color-slate-400: oklch(70.4% 0.04 256.788);\n    --color-slate-500: oklch(55.4% 0.046 257.417);\n    --color-slate-600: oklch(44.6% 0.043 257.281);\n    --color-slate-700: oklch(37.2% 0.044 257.287);\n    --color-slate-800: oklch(27.9% 0.041 260.031);\n    --color-slate-900: oklch(20.8% 0.042 265.755);\n    --color-slate-950: oklch(12.9% 0.042 264.695);\n    --color-white: #fff;\n    --spacing: 0.25rem;\n    --container-5xl: 64rem;\n    --container-6xl: 72rem;\n    --text-xs: 0.75rem;\n    --text-xs--line-height: calc(1 / 0.75);\n    --text-sm: 0.875rem;\n    --text-sm--line-height: calc(1.25 / 0.875);\n    --text-base: 1rem;\n    --text-base--line-height: calc(1.5 / 1);\n    --text-lg: