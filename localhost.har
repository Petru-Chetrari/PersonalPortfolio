          "cookies": [],
          "content": {
            "size": 12104,
            "mimeType": "text/javascript",
            "text": "document.addEventListener(\"astro:page-load\", () => {\n  const form = document.getElementById(\"signin-form\");\n  if (!form) return;\n  const usernameInput = document.getElementById(\"username\");\n  const passwordInput = document.getElementById(\"password\");\n  const usernameError = document.getElementById(\"username-error\");\n  const passwordError = document.getElementById(\"password-error\");\n  form.addEventListener(\"submit\", (e) => {\n    e.preventDefault();\n    let valid = true;\n    if (!usernameInput.value.trim()) {\n      usernameError.classList.remove(\"hidden\");\n      usernameInput.style.borderColor = \"#EF4444\";\n      valid = false;\n    } else {\n      usernameError.classList.add(\"hidden\");\n      usernameInput.style.borderColor = \"#334155\";\n    }\n    if (!passwordInput.value.trim()) {\n      passwordError.classList.remove(\"hidden\");\n      passwordInput.style.borderColor = \"#EF4444\";\n      valid = false;\n    } else {\n      passwordError.classList.add(\"hidden\");\n      passwordInput.style.borderColor = \"#334155\";\n    }\n    if (valid) {\n      const username = usernameInput.value.trim();\n      const password = passwordInput.value;\n      const apiBase = \"http://localhost:3001\";\n      fetch(`${apiBase}/api/auth/login`, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          \"ngrok-skip-browser-warning\": \"true\"\n        },\n        body: JSON.stringify({ username, password })\n      }).then(async (res) => {\n        const data = await res.json();\n        if (res.ok) {\n          document.cookie = `access_token=${data.accessToken}; path=/; max-age=900; SameSite=Lax`;\n          document.cookie = `refresh_token=${data.refreshToken}; path=/; max-age=604800; SameSite=Lax`;\n          window.location.href = data.role === \"admin\" ? \"/admin\" : \"/client/commissions\";\n        } else {\n          alert(data.error || \"Invalid credentials\");\n        }\n      }).catch(() => {\n        alert(\"Failed to sign in. Please try again later.\");\n      });\n    }\n  });\n});\n\n//# sourceMappingURL=data:application/json;base64,"
          },
          "redirectURL": "",
          "headersSize": 179,
          "bodySize": 0,
