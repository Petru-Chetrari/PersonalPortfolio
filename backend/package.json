{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "In-memory REST API for PersonalPortfolio",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate -- -d src/data-source.ts src/migrations/InitialSchema",
    "migration:run": "npm run typeorm migration:run -- -d src/data-source.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "msnodesqlv8": "^5.2.0",
    "mssql": "^12.5.4",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
