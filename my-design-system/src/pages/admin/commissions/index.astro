---
import AdminDashboard from '../../../layouts/AdminDashboard.astro';
---

<AdminDashboard>
  <div id="admin-commissions" class="p-2">
    <!-- Page header within card -->
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <div>
        <h2 class="text-xl font-bold text-slate-50 font-['Segoe_UI',sans-serif] tracking-tight">Commissions</h2>
        <p class="text-slate-400 text-sm mt-0.5 font-['Segoe_UI_Emoji',sans-serif]">Review and manage all commission requests.</p>
      </div>
      <!-- Filter pills -->
      <div class="flex items-center gap-2 flex-wrap">
        <button id="filter-all" data-filter="all"
          class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-150 font-['Segoe_UI',sans-serif] active-filter"
          style="background-color:#3B82F6; color:#fff;">
          All
        </button>
        <button id="filter-pending" data-filter="pending"
          class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-150 font-['Segoe_UI',sans-serif]"
          style="background-color:#1E293B; color:#94A3B8; border:1px solid #334155;">
          Pending
        </button>
        <button id="filter-active" data-filter="active"
          class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-150 font-['Segoe_UI',sans-serif]"
          style="background-color:#1E293B; color:#94A3B8; border:1px solid #334155;">
          Active
        </button>
        <button id="filter-completed" data-filter="completed"
          class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-150 font-['Segoe_UI',sans-serif]"
          style="background-color:#1E293B; color:#94A3B8; border:1px solid #334155;">
          Completed
        </button>
      </div>
    </div>

    <!-- Commission list -->
    <div id="commission-list" class="flex flex-col gap-3">
      <!-- Row template repeated -->
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden flex flex-col items-center justify-center py-20 text-center">
      <div class="w-12 h-12 rounded-full flex items-center justify-center mb-4" style="background-color:#1E293B; border:1px solid #334155;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2" stroke="#64748B" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="text-slate-400 text-sm font-['Segoe_UI_Emoji',sans-serif]">No commissions found for this filter.</p>
    </div>
  </div>

  <script>
    import { MockRepository, type Commission, type Status } from '../../../lib/mock-repository';

    const statusConfig: Record<Status, {label: string; color: string; bg: string; dot: string}> = {
      pending:   { label: 'Pending',   color: '#FFB900', bg: 'rgba(255,185,0,0.1)',   dot: '#FFB900' },
      active:    { label: 'Active',    color: '#00BC7D', bg: 'rgba(0,188,125,0.1)',   dot: '#00BC7D' },
      completed: { label: 'Completed', color: '#3B82F6', bg: 'rgba(59,130,246,0.1)',  dot: '#3B82F6' },
      overdue:   { label: 'Overdue',   color: '#FF2056', bg: 'rgba(255,32,86,0.1)',   dot: '#FF2056' },
    };

    function renderRow(c: Commission): string {
      const s = statusConfig[c.status];
      
      let actionBtn = '';
      if (c.status === 'pending') {
        actionBtn = `<button class="action-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 transition-colors border border-emerald-500/20 font-['Segoe_UI',sans-serif] shrink-0" data-id="${c.id}" data-action="active">Approve</button>`;
      } else if (c.status === 'active') {
        actionBtn = `<button class="action-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-500/10 text-blue-400 hover:bg-blue-500/20 transition-colors border border-blue-500/20 font-['Segoe_UI',sans-serif] shrink-0" data-id="${c.id}" data-action="completed">Complete</button>`;
      }

      return `
        <div class="commission-row flex items-center gap-4 rounded-2xl px-5 py-4 transition-colors duration-150 hover:brightness-110"
          data-status="${c.status}"
          style="background-color: #1E293B; border: 1px solid #334155;">
          
          <!-- ID + title -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-mono text-slate-500 font-['Segoe_UI_Emoji',sans-serif]">${c.id}</span>
              <span class="text-sm font-semibold text-slate-50 font-['Segoe_UI',sans-serif] truncate">${c.title}</span>
            </div>
            <div class="flex items-center gap-3 mt-1 flex-wrap">
              <span class="text-xs text-slate-400 font-['Segoe_UI_Emoji',sans-serif]">
                <svg class="inline w-3 h-3 mr-0.5 -mt-0.5" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="7" r="4" stroke="#94A3B8" stroke-width="1.5"/></svg>
                ${c.client}
              </span>
              <span class="text-xs text-slate-500 font-['Segoe_UI_Emoji',sans-serif]">${c.appType}</span>
            </div>
          </div>

          <!-- Dates -->
          <div class="hidden md:flex flex-col items-end gap-1 shrink-0">
            <span class="text-xs text-slate-500 font-['Segoe_UI_Emoji',sans-serif]">Submitted ${c.date}</span>
            <span class="text-xs text-slate-400 font-['Segoe_UI_Emoji',sans-serif]">Due ${c.dueDate}</span>
          </div>

          <!-- Status badge -->
          <div class="shrink-0 flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold font-['Segoe_UI',sans-serif]"
            style="background-color: ${s.bg}; color: ${s.color}; border: 1px solid ${s.color}33;">
            <span class="w-1.5 h-1.5 rounded-full inline-block" style="background-color: ${s.dot};"></span>
            ${s.label}
          </div>

          ${actionBtn || `<svg class="shrink-0 text-slate-600" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="#64748B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`}
        </div>
      `;
    }

    function initAdminCommissions() {
      const list = document.getElementById('commission-list');
      if (!list) return;

      let currentFilter = 'all';

      const renderList = () => {
        const commissions = MockRepository.getCommissions();
        const empty = document.getElementById('empty-state')!;
        const filtered = currentFilter === 'all' ? commissions : commissions.filter(c => c.status === currentFilter);

        if (filtered.length === 0) {
          list.innerHTML = '';
          empty.classList.remove('hidden');
        } else {
          empty.classList.add('hidden');
          list.innerHTML = filtered.map(renderRow).join('');
          
          // Attach action listeners
          list.querySelectorAll<HTMLButtonElement>('.action-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const id = btn.dataset.id!;
              const newStatus = btn.dataset.action as Status;
              
              MockRepository.updateCommissionStatus(id, newStatus);
              renderList(); // re-render instantly!
            });
          });
        }
      };

      // Filter button logic
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      filterBtns.forEach(btn => {
        const newBtn = btn.cloneNode(true) as HTMLButtonElement;
        btn.parentNode?.replaceChild(newBtn, btn);

        newBtn.addEventListener('click', () => {
          document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(b => {
            b.style.backgroundColor = '#1E293B';
            b.style.color = '#94A3B8';
            b.style.border = '1px solid #334155';
          });
          newBtn.style.backgroundColor = '#3B82F6';
          newBtn.style.color = '#fff';
          newBtn.style.border = 'none';
          currentFilter = newBtn.dataset.filter!;
          renderList();
        });
      });

      renderList();
    }

    document.addEventListener('astro:page-load', initAdminCommissions);
  </script>
</AdminDashboard>
