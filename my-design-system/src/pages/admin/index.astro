---
import AdminDashboard from '../../layouts/AdminDashboard.astro';
---

<AdminDashboard>
  <div class="p-2 flex flex-col gap-6">

    <!-- Welcome header -->
    <div class="rounded-2xl p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4"
      style="background: linear-gradient(135deg, rgba(59,130,246,0.12) 0%, rgba(15,23,42,0) 60%); border: 1px solid rgba(59,130,246,0.2);">
      <div>
        <p class="text-xs font-semibold text-blue-400 uppercase tracking-widest mb-1 font-['Segoe_UI',sans-serif]">Admin Portal</p>
        <h2 class="text-2xl font-black text-slate-50 font-['Segoe_UI',sans-serif] tracking-tight">Welcome back 👋</h2>
        <p class="text-slate-400 text-sm mt-1 font-['Segoe_UI_Emoji',sans-serif]">Here's an overview of your platform at a glance.</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a href="/admin/commissions"
          class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white font-['Segoe_UI',sans-serif] transition-all hover:opacity-90"
          style="background-color: #3B82F6;">
          View commissions
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/admin/stats"
          class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-300 font-['Segoe_UI',sans-serif] transition-all hover:bg-slate-700"
          style="background-color: #1E293B; border: 1px solid #334155;">
          Stats
        </a>
      </div>
    </div>

    <!-- Quick-stats row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { label: 'Total commissions', value: '24', icon: `<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/>`, color: '#3B82F6', bg: 'rgba(59,130,246,0.1)', delta: '+3 this month' },
        { label: 'Active', value: '8', icon: `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`, color: '#00BC7D', bg: 'rgba(0,188,125,0.1)', delta: 'In progress' },
        { label: 'Pending', value: '7', icon: `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`, color: '#FFB900', bg: 'rgba(255,185,0,0.1)', delta: 'Awaiting review' },
        { label: 'Revenue', value: '$9.5k', icon: `<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`, color: '#F59E0B', bg: 'rgba(245,158,11,0.1)', delta: 'From 12 completed' },
      ].map(({ label, value, icon, color, bg, delta }) => (
        <div class="rounded-2xl p-4 flex flex-col gap-3" style={`background-color: ${bg}; border: 1px solid ${color}33;`}>
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider font-['Segoe_UI',sans-serif]" style={`color: ${color};`}>{label}</span>
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style={`background-color: ${color}20; color: ${color};`}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" set:html={icon} />
            </div>
          </div>
          <div>
            <p class="text-3xl font-bold text-slate-50 font-['Segoe_UI',sans-serif]">{value}</p>
            <p class="text-xs text-slate-500 mt-0.5 font-['Segoe_UI_Emoji',sans-serif]">{delta}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Quick actions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {[
        { href: '/admin/projects', label: 'Manage Projects', desc: 'Add, edit or remove portfolio projects.', icon: `<rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/>`, color: '#3B82F6' },
        { href: '/admin/commissions', label: 'View Commissions', desc: 'Manage all incoming commission requests.', icon: `<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`, color: '#00BC7D' },
        { href: '/admin/stats', label: 'Analytics & Stats', desc: 'View revenue, trends, and performance data.', icon: `<path d="M3 3v18h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 16l4-4 4 4 4-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`, color: '#8B5CF6' },
      ].map(({ href, label, desc, icon, color }) => (
        <a href={href}
          class="group rounded-2xl p-5 flex flex-col gap-3 transition-all duration-200 hover:brightness-110"
          style="background-color: #1E293B; border: 1px solid #334155;">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center" style={`background-color: ${color}20; color: ${color};`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" set:html={icon} />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-50 font-['Segoe_UI',sans-serif]">{label}</p>
            <p class="text-xs text-slate-500 mt-0.5 font-['Segoe_UI_Emoji',sans-serif]">{desc}</p>
          </div>
          <div class="flex items-center gap-1 text-xs font-medium mt-auto font-['Segoe_UI',sans-serif]" style={`color: ${color};`}>
            Go to {label.split(' ')[1] || label}
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
              <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</AdminDashboard>
