---
import AdminDashboard from '../../../layouts/AdminDashboard.astro';
---

<AdminDashboard>
  <div id="admin-stats-table" class="p-4 flex flex-col gap-6 max-w-6xl mx-auto">

    <!-- Header row -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <a href="/admin/stats" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-100 hover:bg-slate-800 transition-all font-['Segoe_UI_Emoji']">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <h2 class="text-2xl font-bold text-slate-50 font-['Segoe_UI',sans-serif] tracking-tight">Interaction Events Log</h2>
        </div>
        <p class="text-slate-400 text-sm font-['Segoe_UI_Emoji',sans-serif] pl-11">Detailed high-fidelity record of user sessions and action targets.</p>
      </div>

      <!-- Search -->
      <div class="flex items-center gap-3">
        <div class="relative">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500" width="16" height="16" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
            <path d="M21 21l-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="Search events…"
            class="pl-10 pr-4 py-2.5 rounded-xl text-sm text-slate-200 placeholder-slate-500 outline-none transition-all w-64 font-['Segoe_UI_Emoji',sans-serif] focus:ring-2 focus:ring-blue-500"
            style="background-color: #0F172A; border: 1px solid #334155;"
          />
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded-2xl overflow-hidden shadow-2xl" auto-animate style="background-color: #0F172A; border: 1px solid #1E293B;">
      <div class="overflow-x-auto">
      <table class="w-full text-sm whitespace-nowrap" id="stats-table">
        <thead>
          <tr style="background-color: #111827; border-bottom: 1px solid #1E293B;">
            <th class="px-6 py-4 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider font-['Segoe_UI',sans-serif] cursor-pointer hover:text-slate-200 group" data-col="timestamp">
              Timestamp <span class="sort-icon opacity-0 group-hover:opacity-100 transition-opacity ml-1">↓</span>
            </th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider font-['Segoe_UI',sans-serif] cursor-pointer hover:text-slate-200 group" data-col="deviceOs">
              Device / OS <span class="sort-icon opacity-0 group-hover:opacity-100 transition-opacity ml-1"></span>
            </th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider font-['Segoe_UI',sans-serif] cursor-pointer hover:text-slate-200 group hidden sm:table-cell" data-col="targetType">
              Target Type <span class="sort-icon opacity-0 group-hover:opacity-100 transition-opacity ml-1"></span>
            </th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider font-['Segoe_UI',sans-serif] cursor-pointer hover:text-slate-200 group hidden sm:table-cell" data-col="targetId">
              Target ID <span class="sort-icon opacity-0 group-hover:opacity-100 transition-opacity ml-1"></span>
            </th>
          </tr>
        </thead>
        <tbody id="table-body">
        </tbody>
      </table>
      </div>

      <!-- Pagination -->
      <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 gap-4" style="border-top: 1px solid #1E293B;">
        <p class="text-sm text-slate-500 font-['Segoe_UI_Emoji',sans-serif]" id="pagination-info">Loading...</p>
        <div class="flex items-center gap-2">
          <button id="prev-page" class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-400 hover:text-slate-100 hover:bg-slate-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all font-['Segoe_UI',sans-serif]" style="background-color:#1E293B; border:1px solid #334155;">Previous</button>
          <button id="next-page" class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-300 hover:text-slate-100 hover:bg-slate-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all font-['Segoe_UI',sans-serif]" style="background-color:#1E293B; border:1px solid #334155;">Next</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { MockRepository } from '../../../lib/mock-repository.svelte.ts';

    // The data structure returned by getInteractionTableData
    interface EventRow {
      id: string;
      timestamp: string;
      deviceOs: string;     
      targetType: string;
      targetId: string;
    }

    let allRows: EventRow[] = [];
    let filtered: EventRow[] = [];
    let page = 0;
    const pageSize = 10;
    
    // Default sorting
    let sortCol = 'timestamp';
    let sortAsc = false; // Descending by timestamp by default

    function initTable() {
      allRows = MockRepository.getInteractionTableData();
      filtered = [...allRows];
      page = 0;
      doSort();
      renderTable();
      setupListeners();
    }

    function doSort() {
       filtered.sort((a: any, b: any) => {
         let valA = a[sortCol] || '';
         let valB = b[sortCol] || '';
         
         if (sortCol === 'timestamp') {
           valA = new Date(valA).getTime();
           valB = new Date(valB).getTime();
         } else {
           valA = valA.toString().toLowerCase();
           valB = valB.toString().toLowerCase();
         }

         if (valA < valB) return sortAsc ? -1 : 1;
         if (valA > valB) return sortAsc ? 1 : -1;
         return 0;
       });
    }

    function renderTable() {
      const tbody = document.getElementById('table-body');
      const info = document.getElementById('pagination-info');
      if (!tbody || !info) return;

      const start = page * pageSize;
      const pageRows = filtered.slice(start, start + pageSize);

      const typeColors: Record<string, {bg: string, text: string, border: string}> = {
          'project': { bg: 'rgba(59,130,246,0.15)', text: '#60A5FA', border: '#3B82F640' },
          'link': { bg: 'rgba(234,179,8,0.15)', text: '#FBBF24', border: '#EAB30840' },
          'button': { bg: 'rgba(168,85,247,0.15)', text: '#C084FC', border: '#A855F740' },
      };

      if (pageRows.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="px-6 py-12 text-center text-slate-500">No matching events found.</td></tr>`;
      } else {
        tbody.innerHTML = pageRows.map((r, i) => {
          const dateObj = new Date(r.timestamp);
          const tString = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + 
                          ' ' + dateObj.toLocaleTimeString('en-US', { hour: '2-digit', minute:'2-digit' });
                          
          const tc = typeColors[r.targetType] || { bg: 'rgba(148,163,184,0.15)', text: '#94A3B8', border: '#94A3B840' };

          return `
            <tr class="border-t transition-colors duration-150 hover:bg-slate-800/40" style="border-color:#1E293B;">
              <td class="px-6 py-4 text-xs text-slate-300 font-mono font-['Segoe_UI_Emoji',sans-serif]">${tString}</td>
              <td class="px-6 py-4 text-sm text-slate-200 font-medium font-['Segoe_UI',sans-serif]">${r.deviceOs}</td>
              <td class="px-6 py-4 text-sm hidden sm:table-cell">
                <span class="px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide" style="background-color:${tc.bg}; color:${tc.text}; border: 1px solid ${tc.border};">
                  ${r.targetType.toUpperCase()}
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-slate-400 font-['Segoe_UI_Emoji',sans-serif] hidden sm:table-cell max-w-[200px] truncate" title="${r.targetId}">
                ${r.targetId}
              </td>
            </tr>
          `;
        }).join('');
      }

      const total = filtered.length;
      if (total === 0) {
          info.textContent = `Showing 0 entries`;
      } else {
          info.textContent = `Showing ${start + 1} to ${Math.min(start + pageSize, total)} of ${total} entries`;
      }

      const btnPrev = document.getElementById('prev-page') as HTMLButtonElement | null;
      const btnNext = document.getElementById('next-page') as HTMLButtonElement | null;

      if (btnPrev) btnPrev.disabled = page === 0;
      if (btnNext) btnNext.disabled = start + pageSize >= total;
      
      // Update sort icons
      document.querySelectorAll('th[data-col]').forEach(th => {
          const icon = th.querySelector('.sort-icon');
          if (icon) {
              if (th.getAttribute('data-col') === sortCol) {
                  icon.textContent = sortAsc ? '↑' : '↓';
                  icon.classList.remove('opacity-0');
              } else {
                  icon.textContent = '↕';
                  icon.classList.add('opacity-0');
              }
          }
      });
    }

    function handleSearch(e: Event) {
      const q = (e.target as HTMLInputElement).value.toLowerCase();
      filtered = allRows.filter(r =>
        r.deviceOs.toLowerCase().includes(q) ||
        r.targetType.toLowerCase().includes(q) ||
        r.targetId.toLowerCase().includes(q) ||
        r.timestamp.toLowerCase().includes(q)
      );
      page = 0;
      doSort();
      renderTable();
    }

    function handleSort(col: string) {
      if (sortCol === col) {
        sortAsc = !sortAsc;
      } else {
        sortCol = col;
        sortAsc = true;
      }
      page = 0;
      doSort();
      renderTable();
    }

    function setupListeners() {
      document.getElementById('search-input')?.addEventListener('input', handleSearch);
      document.getElementById('prev-page')?.addEventListener('click', () => { if (page > 0) { page--; renderTable(); } });
      document.getElementById('next-page')?.addEventListener('click', () => { if ((page + 1) * pageSize < filtered.length) { page++; renderTable(); } });
      
      document.querySelectorAll('th[data-col]').forEach(th => {
        th.addEventListener('click', () => {
          const col = th.getAttribute('data-col');
          if (col) handleSort(col);
        });
      });
    }

    document.addEventListener('astro:page-load', initTable);
  </script>
</AdminDashboard>
