---
import AdminDashboard from '../../../layouts/AdminDashboard.astro';
import Chart from '../../../components/Chart.svelte';
---

<AdminDashboard>
  <div id="admin-stats" class="p-4 flex flex-col gap-8 max-w-6xl mx-auto">
    
    <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-slate-50 font-['Segoe_UI',sans-serif] tracking-tight">Analytics Dashboard</h2>
        <a href="/admin/stats/table" class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-300 transition-all hover:bg-slate-700 font-['Segoe_UI',sans-serif]" style="background-color: #1E293B; border: 1px solid #334155;">
            View Detailed Table
        </a>
    </div>

    <!-- KPI Cards Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Card: Total Commissions -->
      <div class="rounded-2xl p-5 flex flex-col gap-3" style="background-color: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2);">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-blue-400 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Total Commissions</span>
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color:rgba(59,130,246,0.2);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="#3B82F6" stroke-width="1.5" stroke-linecap="round"/>
              <rect x="9" y="3" width="6" height="4" rx="1" stroke="#3B82F6" stroke-width="1.5"/>
            </svg>
          </div>
        </div>
        <div>
          <p class="text-4xl font-bold text-slate-50 font-['Segoe_UI',sans-serif]" id="stat-total">0</p>
          <p class="text-xs text-slate-400 mt-1 font-['Segoe_UI_Emoji',sans-serif]">All time</p>
        </div>
      </div>

      <!-- Card: Active -->
      <div class="rounded-2xl p-5 flex flex-col gap-3" style="background-color: rgba(0,188,125,0.1); border: 1px solid rgba(0,188,125,0.2);">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Active</span>
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color:rgba(0,188,125,0.2);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9" stroke="#00BC7D" stroke-width="1.5"/>
              <path d="M9 12l2 2 4-4" stroke="#00BC7D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div>
          <p class="text-4xl font-bold text-slate-50 font-['Segoe_UI',sans-serif]" id="stat-active">0</p>
          <p class="text-xs text-slate-400 mt-1 font-['Segoe_UI_Emoji',sans-serif]">Currently in progress</p>
        </div>
      </div>

      <!-- Card: Completed -->
      <div class="rounded-2xl p-5 flex flex-col gap-3" style="background-color: rgba(254,154,0,0.1); border: 1px solid rgba(254,154,0,0.2);">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Revenue (Est.)</span>
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color:rgba(254,154,0,0.2);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke="#FE9A00" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div>
          <p class="text-4xl font-bold text-slate-50 font-['Segoe_UI',sans-serif]" id="stat-revenue">$0</p>
          <p class="text-xs text-slate-400 mt-1 font-['Segoe_UI_Emoji',sans-serif]">From completed</p>
        </div>
      </div>
    </div>

    <!-- Interaction Trends Chart -->
    <section class="rounded-2xl p-6 flex flex-col gap-4 shadow-xl" style="background-color: #0F172A; border: 1px solid #1E293B;">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <h3 class="text-lg font-bold text-slate-50 font-['Segoe_UI',sans-serif]">Interaction Trends</h3>
          <p class="text-sm text-slate-400 font-['Segoe_UI_Emoji',sans-serif]">Click-throughs over time</p>
        </div>
        <div class="flex gap-5 text-sm font-semibold text-slate-300 font-['Segoe_UI',sans-serif]">
           <span class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded-md bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>Projects</span>
           <span class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded-md bg-yellow-500 shadow-[0_0_8px_rgba(234,179,8,0.6)]"></span>Links</span>
        </div>
      </div>
      
      <!-- Wrapper for Chart.js instance. Height is handled by Chart.svelte -->
      <Chart client:visible />
    </section>

    <!-- Recent Activity Table -->
    <div class="rounded-2xl overflow-hidden shadow-xl" style="background-color: #0F172A; border: 1px solid #1E293B;">
      <div class="px-6 py-5 border-b" style="border-color: #1E293B;">
        <h3 class="text-lg font-bold text-slate-50 font-['Segoe_UI',sans-serif]">Recent Commissions</h3>
      </div>
      <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left" style="background-color: #111827;">
            <th class="px-6 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Commission</th>
            <th class="px-6 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider font-['Segoe_UI',sans-serif] hidden md:table-cell">Client</th>
            <th class="px-6 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider font-['Segoe_UI',sans-serif] hidden md:table-cell">Date</th>
            <th class="px-6 py-3.5 text-xs font-semibold text-slate-500 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Status</th>
          </tr>
        </thead>
        <tbody id="recent-table-body">
        </tbody>
      </table>
      </div>
    </div>

  </div>

  <script>
    const API = 'http://localhost:3001';

    async function initStats() {
      let stats;
      try {
        const res = await fetch(`${API}/commissions/stats`);
        if (!res.ok) throw new Error(res.status.toString());
        stats = await res.json();
      } catch (err) {
        console.error('[admin/stats] Failed to load stats:', err);
        return;
      }

      // Update KPIs
      const statTotal   = document.getElementById('stat-total');
      const statActive  = document.getElementById('stat-active');
      const statRevenue = document.getElementById('stat-revenue');

      if (statTotal)   statTotal.textContent   = stats.total.toString();
      if (statActive)  statActive.textContent  = stats.active.toString();
      if (statRevenue) statRevenue.textContent = '$' + stats.revenue.toLocaleString();

      // Update Recent Activity Table
      const tbody = document.getElementById('recent-table-body');
      if (tbody) {
        const statusConfig = {
          pending:   { color: '#EAB308', bg: 'rgba(234,179,8,0.15)' },
          active:    { color: '#10B981', bg: 'rgba(16,185,129,0.15)' },
          completed: { color: '#3B82F6', bg: 'rgba(59,130,246,0.15)' },
          overdue:   { color: '#EF4444', bg: 'rgba(239,68,68,0.15)' },
        };

        tbody.innerHTML = (stats.recentActivity ?? []).map((r) => {
          const s = statusConfig[r.status] ?? statusConfig.pending;
          return `
            <tr class="border-t transition-colors duration-150 hover:bg-slate-800/40" style="border-color:#1E293B;">
              <td class="px-6 py-4 text-slate-200 font-medium font-['Segoe_UI',sans-serif] truncate max-w-[200px]">${r.title}</td>
              <td class="px-6 py-4 text-slate-400 font-['Segoe_UI_Emoji',sans-serif] hidden md:table-cell">${r.client}</td>
              <td class="px-6 py-4 text-slate-500 text-xs font-['Segoe_UI_Emoji',sans-serif] hidden md:table-cell">${r.date}</td>
              <td class="px-6 py-4">
                <span class="px-3 py-1.5 rounded-full text-xs font-semibold font-['Segoe_UI',sans-serif]"
                  style="background-color:${s.bg}; color:${s.color}; border: 1px solid ${s.color}30;">
                  ${r.status.charAt(0).toUpperCase() + r.status.slice(1)}
                </span>
              </td>
            </tr>`;
        }).join('');
      }
    }

    document.addEventListener('astro:page-load', initStats);
  </script>
</AdminDashboard>
