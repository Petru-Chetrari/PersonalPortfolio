---
import AdminDashboard from '../../../layouts/AdminDashboard.astro';
---

<AdminDashboard>
  <div id="admin-stats" class="p-2 flex flex-col gap-6">
    
    <!-- KPI Cards Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Card: Total Commissions -->
      <div class="rounded-2xl p-5 flex flex-col gap-3" style="background-color: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2);">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-blue-400 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Total Commissions</span>
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color:rgba(59,130,246,0.2);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="#3B82F6" stroke-width="1.5" stroke-linecap="round"/>
              <rect x="9" y="3" width="6" height="4" rx="1" stroke="#3B82F6" stroke-width="1.5"/>
            </svg>
          </div>
        </div>
        <div>
          <p class="text-4xl font-bold text-slate-50 font-['Segoe_UI',sans-serif]" id="stat-total">24</p>
          <p class="text-xs text-slate-400 mt-1 font-['Segoe_UI_Emoji',sans-serif]">+3 this month</p>
        </div>
      </div>

      <!-- Card: Active -->
      <div class="rounded-2xl p-5 flex flex-col gap-3" style="background-color: rgba(0,188,125,0.1); border: 1px solid rgba(0,188,125,0.2);">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Active</span>
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color:rgba(0,188,125,0.2);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9" stroke="#00BC7D" stroke-width="1.5"/>
              <path d="M9 12l2 2 4-4" stroke="#00BC7D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div>
          <p class="text-4xl font-bold text-slate-50 font-['Segoe_UI',sans-serif]" id="stat-active">8</p>
          <p class="text-xs text-slate-400 mt-1 font-['Segoe_UI_Emoji',sans-serif]">Currently in progress</p>
        </div>
      </div>

      <!-- Card: Completed -->
      <div class="rounded-2xl p-5 flex flex-col gap-3" style="background-color: rgba(254,154,0,0.1); border: 1px solid rgba(254,154,0,0.2);">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Revenue (Est.)</span>
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color:rgba(254,154,0,0.2);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke="#FE9A00" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div>
          <p class="text-4xl font-bold text-slate-50 font-['Segoe_UI',sans-serif]" id="stat-revenue">$9,580</p>
          <p class="text-xs text-slate-400 mt-1 font-['Segoe_UI_Emoji',sans-serif]">From 12 completed</p>
        </div>
      </div>
    </div>

    <!-- Bar Chart Section -->
    <div class="rounded-2xl p-6 flex flex-col gap-5" style="background-color: #0F172A; border: 1px solid #334155;">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h3 class="text-base font-bold text-slate-50 font-['Segoe_UI',sans-serif]">Commissions by Month</h3>
          <p class="text-xs text-slate-400 mt-0.5 font-['Segoe_UI_Emoji',sans-serif]">Last 6 months overview</p>
        </div>
        <a href="/admin/stats/table" class="text-xs text-blue-400 hover:text-blue-300 transition-colors font-['Segoe_UI',sans-serif] flex items-center gap-1">
          View table
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      </div>

      <!-- Chart -->
      <div class="relative h-52 flex items-end gap-3" id="bar-chart" aria-label="Monthly commissions bar chart">
        <!-- Gridlines -->
        <div class="absolute inset-0 flex flex-col justify-between pointer-events-none pb-6">
          {[5, 4, 3, 2, 1].map((_, i) => (
            <div class="w-full border-t border-dashed" style="border-color: #262626;"></div>
          ))}
        </div>

        <!-- Bars (rendered by JS) -->
        <div id="bars-container" class="relative z-10 flex items-end gap-3 w-full h-full pb-6">
        </div>
      </div>
    </div>

    <!-- Recent Activity Table -->
    <div class="rounded-2xl overflow-hidden" style="background-color: #0F172A; border: 1px solid #334155;">
      <div class="px-6 py-4 border-b" style="border-color: #1E293B;">
        <h3 class="text-base font-bold text-slate-50 font-['Segoe_UI',sans-serif]">Recent Activity</h3>
      </div>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left" style="background-color: #111827;">
            <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Commission</th>
            <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider font-['Segoe_UI',sans-serif] hidden md:table-cell">Client</th>
            <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider font-['Segoe_UI',sans-serif] hidden md:table-cell">Date</th>
            <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider font-['Segoe_UI',sans-serif]">Status</th>
          </tr>
        </thead>
        <tbody id="recent-table-body">
        </tbody>
      </table>
    </div>

  </div>

  <script>
    import { MockRepository } from '../../../lib/mock-repository';

    function initStats() {
      const stats = MockRepository.getAdminStats();

      // Update KPIs
      const statTotal = document.getElementById('stat-total');
      const statActive = document.getElementById('stat-active');
      const statRevenue = document.getElementById('stat-revenue');

      if (statTotal) statTotal.textContent = stats.total.toString();
      if (statActive) statActive.textContent = stats.active.toString();
      if (statRevenue) statRevenue.textContent = '$' + stats.revenue.toLocaleString();

      // Update Bar Chart
      const barsContainer = document.getElementById('bars-container');
      if (barsContainer) {
        const maxVal = Math.max(...stats.chartData.map((d: any) => d.value), 10); // Ensure maxVal is at least 10 for visual scale
        barsContainer.innerHTML = stats.chartData.map((d: any, i: number) => {
          const pct = (d.value / maxVal) * 100;
          const isLast = i === stats.chartData.length - 1;
          return `
            <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end">
              <span class="text-xs font-semibold font-['Segoe_UI_Emoji',sans-serif]" style="color:${isLast ? '#3B82F6' : '#64748B'}">
                ${d.value}
              </span>
              <div class="w-full rounded-t-lg transition-all duration-500 ease-out" 
                style="height:${pct}%; background-color:${isLast ? '#3B82F6' : '#1E293B'}; border-top: 2px solid ${isLast ? '#60A5FA' : '#334155'};">
              </div>
              <span class="text-xs text-slate-500 font-['Segoe_UI_Emoji',sans-serif]">${d.month}</span>
            </div>
          `;
        }).join('');
      }

      // Update Recent Activity Table
      const tbody = document.getElementById('recent-table-body');
      if (tbody) {
        const statusConfig: Record<string, {color: string; bg: string}> = {
          pending:   { color: '#FFB900', bg: 'rgba(255,185,0,0.1)' },
          active:    { color: '#00BC7D', bg: 'rgba(0,188,125,0.1)' },
          completed: { color: '#3B82F6', bg: 'rgba(59,130,246,0.1)' },
          overdue:   { color: '#FF2056', bg: 'rgba(255,32,86,0.1)' },
        };

        tbody.innerHTML = stats.recentActivity.map((r: any, i: number) => {
          const s = statusConfig[r.status];
          return `
            <tr class="border-t transition-colors duration-100 hover:brightness-125" style="border-color:#1E293B; background-color:${i%2===0?'transparent':'rgba(30,41,59,0.3)'};">
              <td class="px-6 py-3 text-slate-200 font-medium font-['Segoe_UI',sans-serif] truncate max-w-[200px]">${r.title}</td>
              <td class="px-6 py-3 text-slate-400 font-['Segoe_UI_Emoji',sans-serif] hidden md:table-cell">${r.client}</td>
              <td class="px-6 py-3 text-slate-500 text-xs font-['Segoe_UI_Emoji',sans-serif] hidden md:table-cell">${r.date}</td>
              <td class="px-6 py-3">
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold font-['Segoe_UI',sans-serif]"
                  style="background-color:${s.bg}; color:${s.color};">${r.status.charAt(0).toUpperCase() + r.status.slice(1)}</span>
              </td>
            </tr>
          `;
        }).join('');
      }
    }

    document.addEventListener('astro:page-load', initStats);
  </script>
</AdminDashboard>
