---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Background grid -->
  <div class="min-h-screen bg-slate-950 relative overflow-hidden">
    <!-- Ambient glow blobs -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] rounded-full opacity-20"
        style="background: radial-gradient(circle, #3B82F6 0%, transparent 70%); filter: blur(80px);"></div>
      <div class="absolute top-[60%] -right-40 w-[500px] h-[400px] rounded-full opacity-10"
        style="background: radial-gradient(circle, #8B5CF6 0%, transparent 70%); filter: blur(80px);"></div>
    </div>

    <!-- ── Nav ── -->
    <header class="relative z-20 flex items-center justify-between px-6 md:px-14 py-4 mx-auto max-w-7xl">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2">
        <svg width="17" height="20" viewBox="0 0 17 21" fill="none">
          <path d="M8.5 0L17 5.25V15.75L8.5 21L0 15.75V5.25L8.5 0Z" fill="#3B82F6"/>
        </svg>
        <span class="font-bold text-slate-50 text-lg tracking-tight font-['Segoe_UI',sans-serif]">Antigravity</span>
      </a>

      <!-- Nav pill -->
      <nav class="hidden md:flex items-center gap-1 px-3 py-2 rounded-full font-['Segoe_UI',sans-serif]"
        style="background-color: #1E293B; border: 1px solid #334155;">
        {[
          { href: '/', label: 'Home' },
          { href: '/#work', label: 'Work' },
          { href: '/#about', label: 'About' },
          { href: '/submit-commission', label: 'Commissions' },
        ].map(({ href, label }) => (
          <a href={href}
            class="px-4 py-1.5 rounded-full text-sm text-slate-400 hover:text-slate-100 transition-colors duration-150 font-medium">
            {label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <a href="/signin"
        class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-90 font-['Segoe_UI',sans-serif]"
        style="background-color: #3B82F6;">
        Sign in
      </a>
    </header>

    <!-- ── Hero ── -->
    <section class="relative z-10 flex flex-col items-center text-center px-6 pt-24 pb-20 mx-auto max-w-5xl">

      <!-- Status badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full mb-6 font-['Segoe_UI',sans-serif] text-xs font-semibold"
        style="background-color: #1E293B; border: 1px solid #334155; color: #94A3B8;">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Available for Commissions
      </div>

      <!-- Headline -->
      <h1 class="text-5xl md:text-7xl font-black text-slate-50 leading-[1.05] tracking-tight mb-6 font-['Segoe_UI',sans-serif]">
        Build
        <span style="background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          Digital
        </span>
        <br />Experiences
      </h1>

      <!-- Tagline -->
      <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-['Segoe_UI_Emoji',sans-serif]">
        Full-stack designer &amp; developer crafting premium web applications,
        interactive UIs, and scalable design systems — from concept to deployment.
      </p>

      <!-- Hero CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/submit-commission"
          class="flex items-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold text-white transition-all hover:opacity-90 active:scale-[0.98] font-['Segoe_UI',sans-serif]"
          style="background-color: #3B82F6;">
          Get Started
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/#work"
          class="flex items-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold text-slate-300 transition-all hover:text-white font-['Segoe_UI',sans-serif]"
          style="background-color: #1E293B; border: 1px solid #334155;">
          View Work
        </a>
      </div>

      <!-- Hero badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-10">
        {['Svelte', 'Astro', 'TypeScript', 'Postgres', 'TailwindCSS', 'Figma'].map(tech => (
          <span class="px-3 py-1.5 rounded-full text-xs font-semibold text-slate-400 font-['Segoe_UI',sans-serif]"
            style="background-color: #1E293B; border: 1px solid #334155;">
            {tech}
          </span>
        ))}
      </div>
    </section>

    <!-- ── Stats bar ── -->
    <section class="relative z-10 mx-auto max-w-5xl px-6 mb-20">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { label: 'Projects completed', value: '30+' },
          { label: 'Happy clients', value: '24' },
          { label: 'Years experience', value: '4+' },
          { label: 'Open commissions', value: '3' },
        ].map(({ label, value }) => (
          <div class="rounded-2xl p-5 text-center" style="background-color: #1E293B; border: 1px solid #334155;">
            <p class="text-3xl font-black text-slate-50 font-['Segoe_UI',sans-serif]">{value}</p>
            <p class="text-xs text-slate-400 mt-1 font-['Segoe_UI_Emoji',sans-serif]">{label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Work section ── -->
    <section id="work" class="relative z-10 mx-auto max-w-5xl px-6 mb-24">
      <div class="flex items-center justify-between mb-8 flex-wrap gap-3">
        <div>
          <h2 class="text-2xl font-bold text-slate-50 font-['Segoe_UI',sans-serif] tracking-tight">Selected Work</h2>
          <p class="text-slate-400 text-sm mt-1 font-['Segoe_UI_Emoji',sans-serif]">A curated selection of recent projects</p>
        </div>
        <a href="/admin/projects" class="text-sm text-blue-400 hover:text-blue-300 transition-colors font-['Segoe_UI',sans-serif]">
          View all →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="project-grid">
        {[
          {
            title: 'Antigravity Platform',
            desc: 'Full-stack SaaS dashboard with role-based access control, glassmorphic UI, and a commission management system.',
            tags: ['Svelte', 'Astro', 'TailwindCSS'],
            accent: '#3B82F6',
          },
          {
            title: 'E-commerce Dashboard',
            desc: 'Analytics-first admin panel with real-time metrics, order management, and inventory tracking.',
            tags: ['React', 'TypeScript', 'Postgres'],
            accent: '#8B5CF6',
          },
          {
            title: 'Brand Identity System',
            desc: 'End-to-end design system and Figma component library for a fast-growing SaaS startup.',
            tags: ['Figma', 'Design Systems'],
            accent: '#00BC7D',
          },
          {
            title: 'Mobile App UI',
            desc: 'High-fidelity iOS app prototype with onboarding, notification, and profile flows.',
            tags: ['Figma', 'Prototyping', 'iOS'],
            accent: '#F59E0B',
          },
        ].map(({ title, desc, tags, accent }) => (
          <div class="group rounded-2xl p-6 cursor-pointer transition-all duration-200 hover:brightness-110"
            style="background-color: #1E293B; border: 1px solid #334155;">
            <!-- Color band -->
            <div class="w-10 h-10 rounded-xl mb-4 opacity-80" style={`background-color: ${accent}30; border: 1px solid ${accent}40;`}></div>

            <h3 class="text-base font-bold text-slate-50 mb-2 font-['Segoe_UI',sans-serif]">{title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed mb-4 font-['Segoe_UI_Emoji',sans-serif]">{desc}</p>

            <div class="flex flex-wrap gap-2">
              {tags.map(tag => (
                <span class="px-2.5 py-1 rounded-full text-xs font-medium text-slate-400 font-['Segoe_UI',sans-serif]"
                  style="background-color: rgba(248,250,252,0.05); border: 1px solid #334155;">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── About section ── -->
    <section id="about" class="relative z-10 mx-auto max-w-5xl px-6 mb-24">
      <div class="rounded-2xl p-8 md:p-12 grid grid-cols-1 md:grid-cols-2 gap-8 items-center"
        style="background-color: #1E293B; border: 1px solid #334155;">
        <div>
          <p class="text-xs font-semibold text-blue-400 uppercase tracking-widest mb-3 font-['Segoe_UI',sans-serif]">About me</p>
          <h2 class="text-3xl font-black text-slate-50 font-['Segoe_UI',sans-serif] tracking-tight mb-4">
            Self-taught.<br/>Systems thinker.
          </h2>
          <p class="text-slate-400 leading-relaxed text-sm mb-6 font-['Segoe_UI_Emoji',sans-serif]">
            I build premium digital products that combine thoughtful design with clean, scalable engineering.
            My work spans full-stack web applications, design systems, and UI/UX prototyping —
            always with a focus on performance and visual excellence.
          </p>
          <a href="/submit-commission"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white font-['Segoe_UI',sans-serif]"
            style="background-color: #3B82F6;">
            Start a project
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        </div>

        <!-- Skill list -->
        <div class="flex flex-col gap-3">
          {[
            { label: 'Frontend Development', pct: 95, color: '#3B82F6' },
            { label: 'UI/UX Design', pct: 88, color: '#8B5CF6' },
            { label: 'Backend / APIs', pct: 78, color: '#00BC7D' },
            { label: 'Design Systems', pct: 90, color: '#F59E0B' },
          ].map(({ label, pct, color }) => (
            <div>
              <div class="flex justify-between text-xs mb-1.5 font-['Segoe_UI_Emoji',sans-serif]">
                <span class="text-slate-300">{label}</span>
                <span class="text-slate-500">{pct}%</span>
              </div>
              <div class="h-1.5 rounded-full w-full" style="background-color: #0F172A;">
                <div class="h-full rounded-full" style={`width: ${pct}%; background-color: ${color};`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CTA Banner ── -->
    <section class="relative z-10 mx-auto max-w-5xl px-6 mb-24">
      <div class="rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left"
        style="background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(139,92,246,0.1)); border: 1px solid rgba(59,130,246,0.3);">
        <div>
          <h2 class="text-2xl font-black text-slate-50 font-['Segoe_UI',sans-serif]">Ready to build something?</h2>
          <p class="text-slate-400 text-sm mt-1 font-['Segoe_UI_Emoji',sans-serif]">Let's turn your idea into a polished product.</p>
        </div>
        <a href="/submit-commission"
          class="flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold text-white whitespace-nowrap transition-all hover:opacity-90 font-['Segoe_UI',sans-serif]"
          style="background-color: #3B82F6;">
          Submit a Commission
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- ── Footer ── -->
    <footer class="relative z-10 border-t py-8 px-6 mx-auto max-w-5xl" style="border-color: #1E293B;">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-2">
          <svg width="14" height="16" viewBox="0 0 17 21" fill="none">
            <path d="M8.5 0L17 5.25V15.75L8.5 21L0 15.75V5.25L8.5 0Z" fill="#3B82F6"/>
          </svg>
          <span class="text-slate-400 text-sm font-['Segoe_UI',sans-serif]">Antigravity</span>
        </div>
        <p class="text-xs text-slate-600 font-['Segoe_UI_Emoji',sans-serif]">© 2026 Antigravity. All rights reserved.</p>
        <div class="flex items-center gap-4">
          <a href="/signin" class="text-xs text-slate-500 hover:text-slate-300 transition-colors font-['Segoe_UI',sans-serif]">Admin</a>
          <a href="/submit-commission" class="text-xs text-slate-500 hover:text-slate-300 transition-colors font-['Segoe_UI',sans-serif]">Commissions</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
