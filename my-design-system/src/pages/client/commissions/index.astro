---
import Layout from '../../../layouts/Layout.astro';
import CommissionList from '../../../components/CommissionList.svelte';
import { MockRepository } from '../../../lib/mock-repository.svelte.ts';

const commissionsData = MockRepository.getClientCommissions();
---

<Layout title="Client Portal — Commissions">
  <div class="commissions-wrap">
    <CommissionList data={commissionsData} client:load />
  </div>
</Layout>

<style>
  .commissions-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
</style>
