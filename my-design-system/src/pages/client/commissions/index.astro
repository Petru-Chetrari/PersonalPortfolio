---
import ClientPortal from '../../../layouts/ClientPortal.astro';
---

<ClientPortal>
  <div id="client-commissions" class="flex flex-col gap-5">

    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <h2 class="text-xl font-bold text-slate-50 font-['Segoe_UI',sans-serif] tracking-tight">My Commissions</h2>
        <p class="text-slate-400 text-sm mt-0.5 font-['Segoe_UI_Emoji',sans-serif]">Track the status of your active and past requests.</p>
      </div>
      <a
        href="/submit-commission"
        class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all duration-200 hover:opacity-90 active:scale-[0.98] font-['Segoe_UI',sans-serif]"
        style="background-color: #3B82F6;"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M12 5v14M5 12h14" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        New Commission
      </a>
    </div>

    <!-- Tabs -->
    <div class="flex items-center gap-1 p-1 rounded-xl w-fit" style="background-color:#0F172A; border:1px solid #1E293B;">
      {[
        { id: 'tab-all', filter: 'all', label: 'All' },
        { id: 'tab-active', filter: 'active', label: 'Active' },
        { id: 'tab-pending', filter: 'pending', label: 'Pending' },
        { id: 'tab-completed', filter: 'completed', label: 'Completed' },
      ].map(({ id, filter, label }) => (
        <button
          id={id}
          data-filter={filter}
          class="tab-btn px-4 py-1.5 rounded-lg text-xs font-semibold transition-all duration-150 font-['Segoe_UI',sans-serif]"
          style={filter === 'all' ? 'background-color:#3B82F6; color:#fff;' : 'color:#64748B;'}
        >
          {label}
        </button>
      ))}
    </div>

    <!-- Commission Cards -->
    <div id="card-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

    <!-- Empty -->
    <div id="client-empty" class="hidden flex-col items-center justify-center py-20 text-center">
      <div class="w-14 h-14 rounded-full flex items-center justify-center mb-4" style="background-color:#1E293B; border:1px solid #334155;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="#64748B" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M12 12h.01M12 16h.01M12 8h.01" stroke="#64748B" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="text-slate-400 text-sm font-['Segoe_UI_Emoji',sans-serif] mb-4">No commissions found.</p>
      <a href="/submit-commission"
        class="px-5 py-2 rounded-xl text-sm font-semibold text-white font-['Segoe_UI',sans-serif]"
        style="background-color:#3B82F6;">
        Submit your first one
      </a>
    </div>

  </div>

  <script>
    import { MockRepository, type Commission, type Status } from '../../../lib/mock-repository';

    const statusConfig: Record<Status, {label: string; color: string; bg: string; border: string}> = {
      pending:   { label: 'Pending',   color: '#FFB900', bg: 'rgba(255,185,0,0.08)',  border: 'rgba(255,185,0,0.2)' },
      active:    { label: 'Active',    color: '#00BC7D', bg: 'rgba(0,188,125,0.08)',  border: 'rgba(0,188,125,0.2)' },
      completed: { label: 'Completed', color: '#3B82F6', bg: 'rgba(59,130,246,0.08)', border: 'rgba(59,130,246,0.2)' },
      overdue:   { label: 'Overdue',   color: '#FF2056', bg: 'rgba(255,32,86,0.08)',  border: 'rgba(255,32,86,0.2)' },
    };

    function renderCard(c: Commission): string {
      const s = statusConfig[c.status];
      return `
        <div class="rounded-2xl p-5 flex flex-col gap-4 transition-all duration-200 hover:brightness-110"
          style="background-color:#1E293B; border:1px solid #334155;">

          <!-- Top row -->
          <div class="flex items-start justify-between gap-2">
            <div class="flex-1 min-w-0">
              <p class="text-xs font-mono text-slate-500 mb-0.5 font-['Segoe_UI_Emoji',sans-serif]">${c.id}</p>
              <h3 class="text-sm font-bold text-slate-50 truncate font-['Segoe_UI',sans-serif]">${c.title}</h3>
              <p class="text-xs text-slate-500 mt-0.5 font-['Segoe_UI_Emoji',sans-serif]">${c.appType}</p>
            </div>
            <div class="px-2.5 py-1 rounded-full text-xs font-semibold font-['Segoe_UI',sans-serif] shrink-0"
              style="background-color:${s.bg}; color:${s.color}; border:1px solid ${s.border};">
              ${s.label}
            </div>
          </div>

          <!-- Note -->
          ${c.note ? `
          <div class="text-xs text-slate-400 px-3 py-2.5 rounded-xl font-['Segoe_UI_Emoji',sans-serif]" style="background-color:rgba(15,23,42,0.7); border:1px solid #334155;">
            <svg class="inline w-3 h-3 mr-1 -mt-0.5 text-slate-500" viewBox="0 0 24 24" fill="none">
              <path d="M8 12h8M8 8h5M8 16h5" stroke="#64748B" stroke-width="1.5" stroke-linecap="round"/>
              <rect x="3" y="3" width="18" height="18" rx="2" stroke="#64748B" stroke-width="1.5"/>
            </svg>
            ${c.note}
          </div>` : ''}

          <!-- Dates -->
          <div class="flex items-center justify-between text-xs text-slate-500 font-['Segoe_UI_Emoji',sans-serif]">
            <span>Submitted: ${c.date}</span>
            <span>Due: ${c.dueDate}</span>
          </div>

          <!-- Progress bar (active only) -->
          ${c.status === 'active' ? `
          <div>
            <div class="flex items-center justify-between text-xs mb-1.5 font-['Segoe_UI_Emoji',sans-serif]">
              <span class="text-slate-500">Progress</span>
              <span class="text-slate-300">45%</span>
            </div>
            <div class="h-1.5 rounded-full w-full" style="background-color:#0F172A;">
              <div class="h-full rounded-full" style="width:45%; background: linear-gradient(90deg, #3B82F6, #00BC7D);"></div>
            </div>
          </div>` : ''}
        </div>
      `;
    }

    function initClient() {
      const grid = document.getElementById('card-grid');
      if (!grid) return; // Exit if not on the page

      const data = MockRepository.getClientCommissions();
      let currentFilter = 'all';

      const render = (filter: string) => {
        const empty = document.getElementById('client-empty')!;
        const rows = filter === 'all' ? data : data.filter(c => c.status === filter);

        if (rows.length === 0) {
          grid.innerHTML = '';
          empty.classList.remove('hidden');
          empty.style.display = 'flex';
        } else {
          empty.classList.add('hidden');
          empty.style.display = '';
          grid.innerHTML = rows.map(renderCard).join('');
        }
      };

      // Tabs
      const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
      tabs.forEach(btn => {
        // Remove old listeners to prevent duplicates on soft reload
        const newBtn = btn.cloneNode(true) as HTMLButtonElement;
        btn.parentNode?.replaceChild(newBtn, btn);

        newBtn.addEventListener('click', () => {
          document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(b => { 
            b.style.backgroundColor = ''; b.style.color = '#64748B'; 
          });
          newBtn.style.backgroundColor = '#3B82F6';
          newBtn.style.color = '#fff';
          currentFilter = newBtn.dataset.filter!;
          render(currentFilter);
        });
      });

      render(currentFilter);
    }

    // Run on initial load and view transitions
    document.addEventListener('astro:page-load', initClient);
  </script>
</ClientPortal>
