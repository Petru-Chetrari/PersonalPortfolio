---
// AboutSection.astro — Figma: "Landing > Base > Body > Section[2]"
// Static section. Image asset from Figma Dev Mode MCP.

const imgDev = 'http://localhost:3845/assets/a9c4ead885b6ef39432ecd1004a720dac091d7b2.png';
const imgLinkedIn = 'http://localhost:3845/assets/476d72fb514f6b473af18560b7eabfc548759fdb.svg';
const imgGithub   = 'http://localhost:3845/assets/03aa26d771eba96a6bba80731c78d703ba755c7f.svg';
const imgDownload = 'http://localhost:3845/assets/46fefa6064db1881ae2db34679ef84b753b8abc9.svg';
---

<section id="about" class="about" aria-labelledby="about-heading">
  <!-- Outer card with ambient glows -->
  <div class="about__card">
    <!-- Ambient glow blobs (decorative) -->
    <div class="about__glow about__glow--blue"  aria-hidden="true"></div>
    <div class="about__glow about__glow--teal"  aria-hidden="true"></div>

    <!-- Inner layout -->
    <div class="about__inner">
      <!-- Left: text column -->
      <div class="about__copy">
        <h2 id="about-heading" class="about__heading">About Me</h2>

        <div class="about__paragraphs">
          <p class="about__para">
            I'm a passionate software engineer with over 5 years of experience in
            crafting beautiful, accessible, and highly performant web applications.
            My journey began with a curiosity for how things work on the internet,
            which quickly evolved into a deep-seated passion for creating meaningful
            digital solutions.
          </p>
          <p class="about__para">
            I specialize in the React ecosystem, leveraging modern tools to build
            full-stack applications that scale. When I'm not coding, you can find me
            exploring new design trends, contributing to open-source, or sharing
            knowledge with the community.
          </p>
        </div>

        <!-- Link pills -->
        <div class="about__links">
          <a href="/resume.pdf" download class="about__link about__link--wide" id="about-download-resume">
            <img src={imgDownload} alt="" width="16" height="16" aria-hidden="true" class="about__link-icon" />
            Download Resume
          </a>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer"
             class="about__link about__link--icon" aria-label="GitHub profile" id="about-github">
            <img src={imgGithub} alt="" width="20" height="20" aria-hidden="true" />
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer"
             class="about__link about__link--icon" aria-label="LinkedIn profile" id="about-linkedin">
            <img src={imgLinkedIn} alt="" width="20" height="20" aria-hidden="true" />
          </a>
        </div>
      </div>

      <!-- Right: developer photo -->
      <div class="about__photo-wrap">
        <img src={imgDev} alt="Developer coding in a dark room"
             class="about__photo" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section wrapper ── */
  .about {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1096px;
    margin-inline: auto;
    padding-block: 160px;   /* Figma: py-[160px] */
  }

  /* ── Card ── */
  .about__card {
    position: relative;
    background-color: var(--color-bg-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-3xl);
    overflow: hidden;
    height: 613.6px;
  }

  /* ── Ambient glows ── */
  .about__glow {
    position: absolute;
    border-radius: var(--radius-full);
    pointer-events: none;
  }
  .about__glow--blue {
    width: 500px;
    height: 500px;
    top: -250px;
    left: 844.4px;
    background-color: var(--color-glow-blue);
    filter: blur(120px);
  }
  .about__glow--teal {
    width: 500px;
    height: 500px;
    top: 362px;
    left: -250px;
    background-color: var(--color-glow-teal);
    filter: blur(120px);
  }

  /* ── Inner layout ── */
  .about__inner {
    position: absolute;
    inset: 64px;            /* Figma: left/top 64px, width=966.4px, height=484px */
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  /* ── Left column ── */
  .about__copy {
    width: 451.2px;
    height: 484px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    flex-shrink: 0;
  }

  .about__heading {
    font-family: var(--font-ui);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-primary);
    margin: 0 0 0 0;
    white-space: nowrap;
  }

  .about__paragraphs {
    position: absolute;
    top: 72px;
    left: 0;
    width: 451.2px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about__para {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 448px;
  }

  /* ── Link pills ── */
  .about__links {
    position: absolute;
    bottom: 0;
    left: 0;
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .about__link {
    display: inline-flex;
    align-items: center;
    height: 48px;
    border-radius: var(--radius-full);
    background-color: rgba(51, 65, 85, 0.8);
    text-decoration: none;
    transition: var(--transition-opacity);
  }
  .about__link:hover { opacity: 0.8; }

  .about__link--wide {
    gap: 8px;
    padding: 0 24px 0 24px;
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-normal);
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .about__link-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .about__link--icon {
    width: 44px;
    justify-content: center;
  }

  /* ── Right photo ── */
  .about__photo-wrap {
    width: 451.2px;
    height: 451.2px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-photo);
    flex-shrink: 0;
    margin-top: 16.4px;
  }

  .about__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    display: block;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .about {
      padding-block: 80px;
    }
    .about__card {
      height: auto;
    }
    .about__inner {
      position: static;
      flex-direction: column;
      gap: 40px;
      padding: 40px;
    }
    .about__copy {
      width: 100%;
      height: auto;
      position: static;
    }
    .about__paragraphs {
      position: static;
      width: 100%;
      margin-top: 16px;
    }
    .about__links {
      position: static;
      margin-top: 24px;
    }
    .about__photo-wrap {
      width: 100%;
      height: 320px;
      margin-top: 0;
    }
    .about__glow--blue  { left: 60%; }
    .about__glow--teal  { top: 60%; }
  }
</style>
