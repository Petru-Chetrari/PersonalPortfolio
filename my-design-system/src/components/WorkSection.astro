---
// WorkSection.astro — Figma: "Landing > Base > Body > Section[1]"
// Project cards are loaded at runtime from the backend API.
---

<section id="work" class="work" aria-labelledby="work-heading">
  <!-- Section header -->
  <div class="work__header">
    <h2 id="work-heading" class="work__title">Selected Work</h2>
    <p class="work__subtitle">
      A collection of my recent projects, demonstrating expertise in frontend
      engineering, UI design, and full-stack development.
    </p>
  </div>

  <!-- 3-column project grid — populated by client-side script -->
  <div id="work-grid" class="work__grid"></div>
</section>

<script>
  // Fallback Figma images cycled per project index
  const FALLBACK_IMGS = [
    'http://localhost:3845/assets/9c44f4e01b24f15ff4fb7082364ae55608fb895a.png',
    'http://localhost:3845/assets/6f1b17cd4f51a36cd46c36d2ea1d5a33825be961.png',
    'http://localhost:3845/assets/bee0d7335ba9c7d1cb6f76e9c25452666693add1.png',
  ];

  async function loadProjects() {
    const grid = document.getElementById('work-grid');
    if (!grid) return;

    try {
      const res = await fetch('http://localhost:3001/projects?limit=6');
      if (!res.ok) throw new Error(`${res.status}`);
      const { data } = await res.json();

      grid.innerHTML = data.map((p: any, i: number) => {
        const img  = FALLBACK_IMGS[i % FALLBACK_IMGS.length];
        const tags = (p.tags ?? []).map((t: string) =>
          `<span class="project-card__tag">${t}</span>`
        ).join('');

        return `
          <article class="project-card">
            <div class="project-card__thumb">
              <img src="${img}" alt="${p.title} screenshot"
                   class="project-card__img" loading="lazy" />
            </div>
            <div class="project-card__body">
              <div class="project-card__meta">
                <span class="project-card__type">${p.appType ?? ''}</span>
                <h3 class="project-card__title">${p.title}</h3>
              </div>
              <p class="project-card__desc">${p.shortDesc ?? ''}</p>
              <div class="project-card__tags">${tags}</div>
            </div>
          </article>`;
      }).join('');
    } catch (err) {
      console.warn('[WorkSection] Could not load projects from API:', err);
    }
  }

  document.addEventListener('astro:page-load', loadProjects);
</script>

<style>
  /* ── Section shell ── */
  .work {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 48px;
    width: 100%;
    max-width: 1096px;
    margin-inline: auto;
  }

  /* ── Section header ── */
  .work__header {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-right: 520px;   /* Figma: pr-[520px] on 1096px container leaves 576px */
  }

  .work__title {
    font-family: var(--font-ui);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-primary);
    margin: 0 0 8px 0;
    white-space: nowrap;
  }

  .work__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 499px;
  }

  /* ── Project card grid ── */
  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  /* ── Individual project card ── */
  .project-card {
    background-color: var(--color-bg-overlay);
    border: var(--border-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 1px;           /* Figma: p-px */
    align-self: start;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .project-card:hover {
    border-color: rgba(51, 65, 85, 0.8);
    box-shadow: var(--shadow-hover);
  }

  /* Thumbnail */
  .project-card__thumb {
    background-color: rgba(15, 23, 42, 0.5);
    width: 100%;
    overflow: hidden;
    height: 192.6px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-card__img {
    width: 100%;
    height: 192.6px;
    object-fit: cover;
    pointer-events: none;
    display: block;
  }

  /* Body */
  .project-card__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 273px;
    padding: 24px;
    flex-shrink: 0;
    gap: 10px;
  }

  .project-card__meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-card__type {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 16px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .project-card__title {
    font-family: var(--font-ui);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-relaxed);
    color: var(--color-text-primary);
    margin: 0;
    white-space: nowrap;
  }

  .project-card__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1 0 0;
  }

  /* Tech bubbles */
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
  }

  .project-card__tag {
    display: inline-flex;
    align-items: center;
    height: 23.988px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background-color: rgba(51, 65, 85, 0.8);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    line-height: 16px;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .work__header { padding-right: 0; }
    .work__grid { grid-template-columns: 1fr; }
  }

  @media (min-width: 601px) and (max-width: 900px) {
    .work__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
