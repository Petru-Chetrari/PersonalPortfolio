---
import Layout from './Layout.astro';

const { title = 'Client Portal', description = 'Manage your commissions.' } = Astro.props;
---

<Layout>
  <div class="min-h-screen bg-slate-950 flex">

    <!-- Client Sidebar -->
    <aside
      id="client-sidebar"
      class="hidden md:flex flex-col w-60 shrink-0 py-6 px-4 gap-6"
      style="background-color: rgba(15,23,42,0.9); border-right: 1px solid #1E293B;"
    >
      <!-- Brand -->
      <div class="flex items-center gap-2 px-2 py-1">
        <svg width="16" height="19" viewBox="0 0 17 21" fill="none">
          <path d="M8.5 0L17 5.25V15.75L8.5 21L0 15.75V5.25L8.5 0Z" fill="#3B82F6"/>
        </svg>
        <span class="font-bold text-slate-50 text-base tracking-tight font-['Segoe_UI',sans-serif]">Antigravity</span>
      </div>

      <!-- Client label -->
      <div class="px-2">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 font-['Segoe_UI',sans-serif]">Client Portal</p>
        <nav class="flex flex-col gap-1">
          {[
            { href: '/client/commissions', label: 'My Commissions', icon: `<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/>` },
            { href: '/submit-commission', label: 'New Commission', icon: `<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>` },
          ].map(({ href, label, icon }) => (
            <a
              href={href}
              class="client-nav-link flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors duration-150 font-['Segoe_UI',sans-serif]"
              style="color: #94A3B8;"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="shrink-0" set:html={icon} />
              {label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Bottom: account -->
      <div class="mt-auto border-t pt-4" style="border-color: #1E293B;">
        <div class="flex items-center gap-2.5 px-2 py-1 rounded-xl" style="background-color:#1E293B;">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white font-['Segoe_UI',sans-serif]" style="background-color:#3B82F6;">
            C
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-slate-200 truncate font-['Segoe_UI',sans-serif]">Client User</p>
            <p class="text-xs text-slate-500 truncate font-['Segoe_UI_Emoji',sans-serif]">client@example.com</p>
          </div>
        </div>
        <a href="/signout" class="flex items-center gap-2 px-3 py-2 mt-2 rounded-xl text-xs text-slate-500 hover:text-slate-300 transition-colors font-['Segoe_UI',sans-serif]">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Sign out
        </a>
      </div>
    </aside>

    <!-- Main content -->
    <main class="flex-1 overflow-auto">
      <!-- Mobile topbar -->
      <div class="md:hidden flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid #1E293B; background-color: rgba(15,23,42,0.95);">
        <div class="flex items-center gap-2">
          <svg width="14" height="16" viewBox="0 0 17 21" fill="none">
            <path d="M8.5 0L17 5.25V15.75L8.5 21L0 15.75V5.25L8.5 0Z" fill="#3B82F6"/>
          </svg>
          <span class="font-bold text-slate-50 text-sm font-['Segoe_UI',sans-serif]">Client Portal</span>
        </div>
        <a href="/submit-commission"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white font-['Segoe_UI',sans-serif]"
          style="background-color:#3B82F6;">
          + New
        </a>
      </div>

      <div class="p-6 max-w-5xl mx-auto">
        <slot />
      </div>
    </main>
  </div>

  <script>
    // Highlight active nav link
    const links = document.querySelectorAll<HTMLAnchorElement>('.client-nav-link');
    links.forEach(link => {
      if (link.href === window.location.href || window.location.pathname.startsWith(new URL(link.href).pathname)) {
        link.style.color = '#F8FAFC';
        link.style.backgroundColor = 'rgba(59,130,246,0.15)';
      }
    });
  </script>
</Layout>
